CREATE TABLE FeePayments (
    payment_id INT PRIMARY KEY,
    student_name VARCHAR(100) NOT NULL,
    amount DECIMAL(10,2) CHECK (amount > 0),
    payment_date DATE NOT NULL
);

-- Part A: Insert multiple payments
BEGIN;
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES (1, 'Ashish', 5000.00, DATE '2024-06-01');
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES (2, 'Smaran', 4500.00, DATE '2024-06-02');
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES (3, 'Vaibhav', 5500.00, DATE '2024-06-03');
COMMIT;
SELECT * FROM FeePayments;

-- Part B: Failed insert triggers rollback
BEGIN;
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES (4, 'Kiran', 4800.00, DATE '2024-06-04');
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES (1, 'Ashish', -5000.00, DATE '2024-06-01');
ROLLBACK;
SELECT * FROM FeePayments;

-- Part C: Partial failure triggers rollback
BEGIN;
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES (5, 'Riya', 4700.00, DATE '2024-06-05');
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES (6, NULL, 4900.00, DATE '2024-06-06');
ROLLBACK;
SELECT * FROM FeePayments;

-- Part D: ACID demonstration
BEGIN;
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES (7, 'Sneha', 4700.00, DATE '2024-06-08');
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES (8, 'Arjun', 4900.00, DATE '2024-06-09');
COMMIT;

BEGIN;
INSERT INTO FeePayments (payment_id, student_name, amount, payment_date) VALUES (3, 'Vaibhav', 5500.00, DATE '2024-06-03');
